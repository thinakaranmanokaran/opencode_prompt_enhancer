{
  "name": "opencode-prompt-enhancer",
  "version": "1.0.3",
  "description": "OpenCode TUI plugin that enhances the user's prompt through a /enhance modal.",
  "type": "module",
  "license": "MIT",
  "author": "Thinakaran Manokaran",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thinakaranmanokaran/opencode_prompt_enhancer.git"
  },
  "homepage": "https://github.com/thinakaranmanokaran/opencode_prompt_enhancer#readme",
  "bugs": {
    "url": "https://github.com/thinakaranmanokaran/opencode_prompt_enhancer/issues"
  },
