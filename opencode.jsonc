{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "D:/GitHub/Open Source/opencode_prompt_enhancer",
      "options": {
        "role": "Software Developer",
        "experience": "25 years",
        "specialties": ["TypeScript", "OpenCode plugins", "SolidJS"],
        "tone": "direct and practical",
        "style": "balanced",
        "language": "auto",
        "rules": [
          "Preserve the user's intent and technical meaning.",
          "Never invent files, APIs, requirements, or values that are not stated.",
          "Include acceptance criteria and a verification step when relevant."
        ]
      }
    }
  ]
}
